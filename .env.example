# Copy to .env and adjust. Real environment variables take precedence over this file.

APP_ENV=development            # "production" hides errors and the on-screen MFA code
APP_URL=http://localhost:8000  # used in emailed links
APP_TIMEZONE=America/Los_Angeles
SESSION_TIMEOUT=600            # seconds of inactivity before logout

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bank_of_the_future
DB_USER=root
DB_PASS=

# Leave SMTP_HOST empty to write emails to storage/logs/mail.log instead of sending them.
# For Gmail, use smtp.gmail.com / 587 and an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@bankofthefuture.test
MAIL_FROM_NAME=Bank of the Future
